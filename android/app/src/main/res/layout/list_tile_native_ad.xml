<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView 
 xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent"
 android:layout_height="400dp"
 android:background="#1E1E1E">

 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">

   <com.google.android.gms.ads.nativead.MediaView android:id="@+id/ad_media" android:layout_width="match_parent" android:layout_height="180dp" />

   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
     <ImageView android:id="@+id/ad_app_icon" android:layout_width="40dp" android:layout_height="40dp"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
       <TextView android:id="@+id/ad_headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textStyle="bold" android:maxLines="1"/>
       <TextView android:id="@+id/ad_advertiser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAAAAA" android:textSize="12sp"/>
     </LinearLayout>
   </LinearLayout>

   <TextView android:id="@+id/ad_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" android:maxLines="2" android:layout_marginTop="8dp"/>
   
   <Button android:id="@+id/ad_call_to_action" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="#00FF88" android:textColor="#000000" android:text="INSTALL"/>

 </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
