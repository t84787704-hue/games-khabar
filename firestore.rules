rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users: anyone can read profiles, user can edit only own users/{uid}
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'postsCount']));
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Saved News subcollection
      match /saved_news/{newsId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Gaming News
    match /gaming_news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // Posts: anyone can read, only owner can delete own post
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }

    // Follows
    match /follows/{followId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    // Squads / LFG posts
    match /lfg_posts/{postId} {
      allow read: if resource.data.isActive == true || (request.auth != null && (request.auth.uid in resource.data.members || resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && (request.resource.data.ownerId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || request.auth.uid in request.resource.data.joinRequests || request.auth.uid in resource.data.joinRequests || request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members);
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);

      match /requests/{reqId} {
        allow read, write: if request.auth != null;
      }
    }

    // Squad chat
    match /chats/{postId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.members);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members);
      allow delete: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /squads/{squadId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;

      match /requests/{requestId} {
        allow read, write: if request.auth != null;
      }
    }

    match /squad_posts/{squadId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Match all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
