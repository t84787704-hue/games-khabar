rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // News Collection Rules - Allow read/write for testing
    match /news/{newsId} {
      allow read, write: if true;
    }

    // RSS Sources Collection Rules - Allow read/write for testing
    match /rss_sources/{sourceId} {
      allow read, write: if true;
    }

    // Scraper Sources Collection Rules
    match /scraper_sources/{sourceId} {
      allow read, write: if true;
    }

    // Match all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
